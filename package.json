{
  "name": "eastward.js",
  "version": "0.0.56",
  "description": "TypeScript library for importing and exporting assets of the video game Eastward.",
  "type": "commonjs",
  "imports": {
    "#*": {
      "eastward-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "eastward": "dist/bin.js"
  },
  "scripts": {
    "test": "npm run build && node --test tests/*.cjs",
    "test:game": "npm run build && node scripts/audit-game.cjs",
    "test:bin": "npm run build && node ./dist/bin.js",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node ./dist/index.js",
    "dev": "node --conditions=eastward-source --import tsx --watch ./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VriskaSerket51/eastward.js.git"
  },
  "keywords": [
    "video-game",
    "reverse-engineering",
    "import-export",
    "asset-extraction",
    "javascript",
    "typescript"
  ],
  "author": "IREVES",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/VriskaSerket51/eastward.js/issues"
  },
  "homepage": "https://github.com/VriskaSerket51/eastward.js#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lunapaint/png-codec": "^0.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "@rinsuki/lz4-ts": "^1.0.1",
    "luajit-decompiler": "https://github.com/VriskaSerket51/node-luajit-decompiler/archive/b78439e.tar.gz",
    "node-webpmux": "^3.2.1",
    "pofile": "^1.1.4",
    "wasmoon-lua5.1": "^1.18.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz",
    "xml2js": "^0.6.2"
  },
  "allowScripts": {
    "luajit-decompiler": true
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
